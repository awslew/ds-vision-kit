# ds-vision-kit configuration — copy this file to `.env` (or set VISION_ENV_FILE)
# and fill in ONE OpenAI-compatible vision endpoint. Every option is optional
# except VISION_API_KEY / VISION_BASE_URL / VISION_MODEL.

# --- Required ----------------------------------------------------------------

# Bearer token for your provider. NEVER commit a real key.
VISION_API_KEY=

# Any OpenAI-compatible /chat/completions endpoint. Examples:
#   OpenRouter:   https://openrouter.ai/api/v1
#   OpenAI:       https://api.openai.com/v1
#   Self-hosted:  http://localhost:8000/v1   (vLLM / Ollama / LM Studio)
#   OpenCode Go:  https://opencode.ai/zen/go/v1   (works but see VISION_ORIGIN)
VISION_BASE_URL=

# A vision-capable model id on that endpoint. Examples:
#   OpenRouter:   openai/gpt-4o-mini   or   qwen/qwen3-vl-32b-instruct
#   OpenAI:       gpt-4o-mini
#   OpenCode Go:  mimo-v2.5
VISION_MODEL=

# --- Optional ----------------------------------------------------------------

# Answer language: zh (default) or en
# LANG=zh

# Explicit path to this env file, if not `.env` in the repo root
# VISION_ENV_FILE=

# Per-request timeout in seconds (default 180). Some providers are slow on
# large images; raise it if you hit timeouts.
# VISION_TIMEOUT=180

# Retries on 429 / 5xx / network errors (default 2)
# VISION_RETRIES=2

# Sampling temperature. Leave empty for the provider default. Set to 0 for
# deterministic chart/data reading.
# VISION_TEMPERATURE=0

# Override the default browser User-Agent. Defaults to a Chrome UA, which some
# Cloudflare-gated providers (e.g. opencode.ai/zen) require or they return
# HTTP 1010. Set to empty (VISION_USER_AGENT=) to send a plain client.
# VISION_USER_AGENT=Mozilla/5.0 ...

# Some Cloudflare-gated providers also require Origin/Referer headers. This is
# set automatically for base URLs containing "opencode.ai"; set it explicitly
# for other providers that 1010-block non-browser clients.
# VISION_ORIGIN=https://your-provider.example.com

# Cap on generated tokens (default: provider decides). Useful for OCR/chat
# dumps that otherwise run long.
# VISION_MAX_TOKENS=4096
